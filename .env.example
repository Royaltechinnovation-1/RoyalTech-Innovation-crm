# ── RoyalTech CRM — copy to `.env` and fill real values ─────────────────────
# Dashboards already run on memory fallback. Fill these for best / production.

# API
API_PORT=4000
VITE_API_URL=http://localhost:4000

# 1) MySQL (required for shared live data across all dashboards)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=royaltech_crm

# 2) Google Sign-In (HR Google unlock + optional SSO)
# Google Cloud → APIs & Services → Credentials → OAuth client (Web)
# Authorized JS origins: http://localhost:5173 + your live domain
VITE_GOOGLE_CLIENT_ID=

# 3) Mail / Messages email delivery (Titan or Gmail App Password)
MAIL_PROVIDER=titan
MAIL_FROM=hr@yourdomain.com
MAIL_SMTP_HOST=smtp.titan.email
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_PASS=
# MAIL_PASSWORD=

# Optional second mailbox (personal Gmail for HR messages UI)
# MAIL_GMAIL_USER=
# MAIL_GMAIL_APP_PASSWORD=

# 4) Google Sheets bridge (Sales → Sheets sync)
# Enable Google Sheets API + Service Account or OAuth in Google Cloud
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# 5) Optional — Maps / office pin (already has Mohali HQ fallback in app)
# VITE_OFFICE_LAT=30.7046
# VITE_OFFICE_LNG=76.7179
# VITE_GOOGLE_MAPS_API_KEY=

# 6) Optional — Website analytics (replace dummy uptime/speed later)
# VITE_GA_MEASUREMENT_ID=
# VITE_PLAUSIBLE_DOMAIN=

# 7) Optional — Realtime messages (today Messages use localStorage + /api/mail)
# When you have a backend chat service, share:
# MESSAGES_API_URL=
# MESSAGES_API_KEY=
